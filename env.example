# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/lia_admin_db"

# JWT Configuration
# IMPORTANT: Use a strong, random secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
# NEVER use the example value in production!
JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Email Configuration (Nodemailer)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="noreply@liaadmin.com"
EMAIL_LOGO_URL="https://your-domain.com/logo.png"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# WhatsApp Configuration
WHATSAPP_API_URL="https://graph.facebook.com/v18.0"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# Payment Configuration
MTN_MOMO_API_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY="your-mtn-subscription-key"
MTN_MOMO_API_USER="your-mtn-api-user"
MTN_MOMO_API_KEY="your-mtn-api-key"

ORANGE_MONEY_API_URL="https://api.orange.com"
ORANGE_MONEY_CLIENT_ID="your-orange-client-id"
ORANGE_MONEY_CLIENT_SECRET="your-orange-client-secret"

# File Upload Configuration
MAX_FILE_SIZE="10485760" # 10MB in bytes
UPLOAD_PATH="./uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000" # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100" # Production: 100, Development: 1000

# CORS Configuration
# Comma-separated list of allowed origins (e.g., "http://localhost:5173,https://yourdomain.com")
# If not set, defaults to FRONTEND_URL
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Health Check Authentication (Production)
# Set a secret to protect health endpoints in production
# Generate with: openssl rand -base64 32
HEALTH_CHECK_SECRET=""

# Request Size Limits
MAX_REQUEST_SIZE="1mb" # Maximum request body size

# AI Configuration
GEMINI_API_KEY=